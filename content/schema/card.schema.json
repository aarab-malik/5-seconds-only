{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameCard",
  "type": "object",
  "required": ["id", "sideA", "sideB", "category", "rating", "difficulty"],
  "properties": {
    "id": { "type": "string" },
    "sideA": { "type": "string", "minLength": 10, "maxLength": 120 },
    "sideB": { "type": "string", "minLength": 10, "maxLength": 120 },
    "category": { "type": "string" },
    "rating": { "enum": ["family", "teen", "adult", "spicy"] },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "enabled": { "type": "boolean" }
  }
}
